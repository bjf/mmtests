#!/bin/bash

###SHELLPACK preamble redis-memtier 1.2.7
GIT_LOCATION="https://github.com/RedisLabs/memtier_benchmark"
MIRROR_LOCATION="$WEBROOT/redis-memtier"

install-depends libopenssl-devel libevent-devel pcre2-devel autogen pcre-devel

###SHELLPACK parseargBegin
###SHELLPACK parseargEnd

###SHELLPACK git_fetch redis-memtier-${VERSION}.tar.gz redis-memtier-${VERSION}

###SHELLPACK build_start redis-memtier-${VERSION}
# memtier_benchmark never calls pcre, but its configure.ac requires the
# original pcre library, which distributions such as Ubuntu 26.04 no longer
# ship. Drop the check, as upstream did in f3545b0 for 2.3.0.
sed -i -e 's/pcre\.h zlib\.h/zlib.h/' -e '/AC_CHECK_LIB(\[pcre\]/d' configure.ac
grep -q pcre configure.ac && die "Failed to remove the pcre check from configure.ac"
autoreconf -ivf || die "Failed to run autoreconf"
###SHELLPACK build_configure redis-memtier-${VERSION}
###SHELLPACK make_make_install

echo redis-memtier installed successfully
exit $SHELLPACK_SUCCESS
